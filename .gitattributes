# core.autocrlf is true on this machine, so line endings are pinned here rather
# than left to a global setting that a future clone may not share.
#
# Git Bash's loader does tolerate a CRLF shebang -- dispatch.sh has run for
# weeks with one -- so this is not load-bearing for the tick. It matters for
# the quieter CRLF failures: a trailing \r inside a quoted string or heredoc
# becomes part of the value, which is how a path or a token silently acquires
# an invisible character.

* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# PowerShell is the exception: it is Windows-only tooling and conventionally
# CRLF, and nothing executes it through a shebang.
*.ps1  text eol=crlf
