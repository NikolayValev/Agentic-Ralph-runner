.env
state/*
!state/.gitkeep
# Run artifacts: prompts embed full ticket text, agent output embeds repo
# contents. Not secrets, but not for the repo either.
logs/*
!logs/.gitkeep
artifacts/*
!artifacts/.gitkeep
__pycache__/
*.pyc
.pytest_cache/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

# Isolated worktrees for plan execution.
.worktrees/

# Run reports handed to notify.py.
logs/report-*.json
