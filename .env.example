# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- CRITICAL ---------------------------------------------------------------
# ANTHROPIC_API_KEY MUST NOT BE SET. In `claude -p` mode a present API key is
# used in preference to the claude.ai subscription and bills per-token.
# preflight.py fails loudly if it is set. Do not add it here.
# ----------------------------------------------------------------------------

# Linear — personal API key (Settings > Security & access > Personal API keys)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# GitHub — needed to push branches and open PRs. NOT in plan v2 §7; added because
# Phase 2 cannot open a PR without it and `gh` is not installed on this machine.
# Scope: `repo` (classic) or contents:write + pull_requests:write (fine-grained).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Vercel — to read the branch's preview deployment URL (Phase 3)
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxx

# Slack (Phases 4-5)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxx
SLACK_CHANNEL=#ralph

# Where the isolated checkout is made. MUST NOT be a working copy you edit.
REPO_DIR=C:/Users/Nikolay/ralph-workspace/quitting-smoking-tracker

# Ollama (Phase 6)
OLLAMA_HOST=http://localhost:11434
